PREFIX edso: <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dct: <http://purl.org/dc/terms/>

SELECT ?score ?release ?round ?site ?data ?decision ?policy WHERE {
  ?score a edso:EvaluationScore ; prov:wasGeneratedBy ?run .
  ?run edso:setting edso:TEF ; edso:evaluatedRelease ?release .
  ?release prov:wasDerivedFrom+/prov:wasGeneratedBy ?round .
  ?round edso:update/prov:wasGeneratedBy ?job .
  ?job edso:atSite ?site ; edso:inputSnapshot ?data ; edso:decisionRecord ?decision .
  ?decision edso:policyVersion ?policy ; dct:subject ?data ; edso:decisionOutcome edso:Permit .
} ORDER BY ?site
