@prefix edso: <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ml: <http://data.europa.eu/it6/> .

<https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> a owl:Ontology ;
    dct:title "Energy Data Space Ontology"@en ;
    owl:versionInfo "0.1.0-draft" ;
    dct:license <https://spdx.org/licenses/MIT.html> ;
    rdfs:comment "Application vocabulary for tracing governed local energy-data use through federated learning to evaluation evidence."@en .

edso:LocalContribution a owl:Class ;
    rdfs:label "Local training contribution"@en ;
    rdfs:comment "One executed training activity for an identified data snapshot at an operator site. Several contributions can participate in one round."@en ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> ;
    rdfs:subClassOf prov:Activity .

edso:FederatedTrainingRound a owl:Class ;
    rdfs:label "Federated training round"@en ;
    rdfs:comment "An orchestration activity that consumes updates produced by local contributors and produces a checkpoint."@en ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> ;
    rdfs:subClassOf prov:Activity .

edso:FoundationModelRelease a owl:Class ;
    rdfs:label "Foundation model release"@en ;
    rdfs:comment "An identifiable version of an energy foundation model available under stated access and licence terms."@en ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> ;
    rdfs:subClassOf ml:MachineLearningModel, prov:Entity .

edso:UseDecision a owl:Class ;
    rdfs:label "Use decision record"@en ;
    rdfs:comment "A dated decision about a requested operation on one dataset under an identified policy version. It can record refusal."@en ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> ;
    rdfs:subClassOf prov:Entity .

edso:PrivacyAccount a owl:Class ;
    rdfs:label "Privacy account statement"@en ;
    rdfs:comment "A reported differential privacy bound for a specified population, neighbouring relation and accounting scope."@en ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> ;
    rdfs:subClassOf prov:Entity .

edso:SyntheticEnergyDataset a owl:Class ;
    rdfs:label "Synthetic energy dataset"@en ;
    rdfs:comment "An energy dataset produced by a synthetic generation process. Quality and privacy evidence may be linked independently."@en ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> ;
    rdfs:subClassOf dcat:Dataset, prov:Entity .

edso:EvaluationRun a owl:Class ;
    rdfs:label "Evaluation run"@en ;
    rdfs:comment "An execution of an evaluation protocol on one model release, at an identified site under a declared scenario."@en ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> ;
    rdfs:subClassOf prov:Activity .

edso:EvaluationScore a owl:Class ;
    rdfs:label "Evaluation score"@en ;
    rdfs:comment "A numeric observation about model performance for one evaluation run, with a metric and unit."@en ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> ;
    rdfs:subClassOf prov:Entity .

edso:EvidenceBundle a owl:Class ;
    rdfs:label "Evidence bundle"@en ;
    rdfs:comment "A collection of references assembled for a stated deployment context and review question."@en ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> ;
    rdfs:subClassOf prov:Collection .

edso:inputSnapshot a owl:ObjectProperty ;
    rdfs:label "input snapshot"@en ;
    rdfs:comment "Dataset version used in one local training activity."@en ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> ;
    rdfs:range dcat:Dataset ;
    rdfs:subPropertyOf prov:used .

edso:decisionRecord a owl:ObjectProperty ;
    rdfs:label "decision record"@en ;
    rdfs:comment "Decision cited by a local contribution for its declared data input and operation."@en ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> ;
    rdfs:range edso:UseDecision .

edso:policyVersion a owl:ObjectProperty ;
    rdfs:label "policy version"@en ;
    rdfs:comment "Identified version of the policy evaluated by the decision maker."@en ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> ;
    rdfs:range odrl:Policy .

edso:decisionOutcome a owl:ObjectProperty ;
    rdfs:label "decision outcome"@en ;
    rdfs:comment "Recorded outcome from the EDSO decision vocabulary."@en ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> ;
    rdfs:range skos:Concept .

edso:requestedAction a owl:ObjectProperty ;
    rdfs:label "requested action"@en ;
    rdfs:comment "Operation to which a decision applies. Use the same action IRI in the referenced ODRL rule."@en ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> ;
    rdfs:range odrl:Action .

edso:requestedBy a owl:ObjectProperty ;
    rdfs:label "requested by"@en ;
    rdfs:comment "Agent requesting the operation. It can differ from the authority recording the decision."@en ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> ;
    rdfs:range prov:Agent .

edso:atSite a owl:ObjectProperty ;
    rdfs:label "at site"@en ;
    rdfs:comment "Identifies the execution location or facility. Associate the responsible agent separately."@en ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> ;
    rdfs:range prov:Location ;
    rdfs:subPropertyOf prov:atLocation .

edso:privacyAccount a owl:ObjectProperty ;
    rdfs:label "privacy account"@en ;
    rdfs:comment "Links work to a scoped privacy accounting statement."@en ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> ;
    rdfs:range edso:PrivacyAccount .

edso:accountScope a owl:ObjectProperty ;
    rdfs:label "accounting scope"@en ;
    rdfs:comment "Activity or sequence covered by the reported bound."@en ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> ;
    rdfs:range prov:Activity .

edso:evaluatedRelease a owl:ObjectProperty ;
    rdfs:label "evaluated release"@en ;
    rdfs:comment "Model release used by a particular evaluation run."@en ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> ;
    rdfs:range edso:FoundationModelRelease ;
    rdfs:subPropertyOf prov:used .

edso:protocol a owl:ObjectProperty ;
    rdfs:label "evaluation protocol"@en ;
    rdfs:comment "Versioned executable specification fixing the task, horizon, metrics and scoring method."@en ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> ;
    rdfs:range prov:Plan ;
    rdfs:subPropertyOf prov:used .

edso:holdout a owl:ObjectProperty ;
    rdfs:label "evaluation holdout"@en ;
    rdfs:comment "Identifiable dataset split used as evaluation input."@en ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> ;
    rdfs:range dcat:Dataset ;
    rdfs:subPropertyOf prov:used .

edso:scenario a owl:ObjectProperty ;
    rdfs:label "scenario"@en ;
    rdfs:comment "Versioned description of workload and operating conditions in the evaluation."@en ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> ;
    rdfs:range prov:Entity .

edso:setting a owl:ObjectProperty ;
    rdfs:label "evaluation setting"@en ;
    rdfs:comment "Environment category such as an AI gym, a TEF or an operational pilot."@en ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> ;
    rdfs:range skos:Concept .

edso:baseline a owl:ObjectProperty ;
    rdfs:label "baseline"@en ;
    rdfs:comment "Versioned reference predictor used for comparison."@en ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> ;
    rdfs:range prov:Entity .

edso:update a owl:ObjectProperty ;
    rdfs:label "local update"@en ;
    rdfs:comment "Update artifact used by a federated round, linked to its generating local activity."@en ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> ;
    rdfs:range prov:Entity ;
    rdfs:subPropertyOf prov:used .

edso:evidenceFor a owl:ObjectProperty ;
    rdfs:label "evidence for"@en ;
    rdfs:comment "Release to which an evidence package refers."@en ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> ;
    rdfs:range edso:FoundationModelRelease .

edso:epsilon a owl:DatatypeProperty ;
    rdfs:label "reported epsilon"@en ;
    rdfs:comment "Epsilon of the reported DP guarantee for the declared delta and scope."@en ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> ;
    rdfs:range xsd:decimal .

edso:delta a owl:DatatypeProperty ;
    rdfs:label "reported delta"@en ;
    rdfs:comment "Delta of the reported DP guarantee for the same scope as epsilon."@en ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> ;
    rdfs:range xsd:decimal .

edso:epsilonLimit a owl:DatatypeProperty ;
    rdfs:label "epsilon ceiling"@en ;
    rdfs:comment "Optional governance ceiling stated for the same delta, adjacency, population and scope."@en ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> ;
    rdfs:range xsd:decimal .

edso:protectedUnit a owl:DatatypeProperty ;
    rdfs:label "protected unit"@en ;
    rdfs:comment "Unit of protection, for example one household across the full period."@en ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> ;
    rdfs:range xsd:string .

edso:adjacency a owl:DatatypeProperty ;
    rdfs:label "adjacency relation"@en ;
    rdfs:comment "Rule specifying which pairs of input datasets are neighbours."@en ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> ;
    rdfs:range xsd:string .

edso:accountant a owl:DatatypeProperty ;
    rdfs:label "accounting method"@en ;
    rdfs:comment "Method and version used to report the bound."@en ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> ;
    rdfs:range xsd:string .

edso:Permit a skos:Concept ; skos:prefLabel "permit"@en ; skos:inScheme edso:DecisionOutcomes .

edso:Deny a skos:Concept ; skos:prefLabel "deny"@en ; skos:inScheme edso:DecisionOutcomes .

edso:Gym a skos:Concept ; skos:prefLabel "AI gym"@en ; skos:inScheme edso:EvaluationSettings .

edso:TEF a skos:Concept ; skos:prefLabel "testing and experimentation facility"@en ; skos:inScheme edso:EvaluationSettings .

edso:Pilot a skos:Concept ; skos:prefLabel "operational pilot"@en ; skos:inScheme edso:EvaluationSettings .

edso:DecisionOutcomes a skos:ConceptScheme ; skos:prefLabel "Decision outcomes"@en .
edso:EvaluationSettings a skos:ConceptScheme ; skos:prefLabel "Evaluation settings"@en .

edso:localTraining a odrl:Action ;
    rdfs:label "local training"@en ;
    rdfs:comment "Execute a model training job within the data holder\u2019s declared site."@en ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ITUAV/edso/main/ontology/edso.ttl> ;
    odrl:includedIn odrl:use .
